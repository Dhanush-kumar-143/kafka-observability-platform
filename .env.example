# Copy to .env and edit. Docker Compose reads it automatically.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Set to true to avoid calling external APIs (Open-Meteo, CoinGecko, Hacker News)
SIMULATED_DATA=false

# Artificial processing delay per message. Raise it to build consumer lag.
CONSUMER_DELAY_MS=0
